{
    "name": "booru-uploader",
    "private": true,
    "version": "1.4.10",
    "type": "module",
    "scripts": {
        "dev": "pnpm build:worker && wxt",
        "dev:firefox": "pnpm build:worker && wxt -b firefox",
        "build": "pnpm build-lib && pnpm build:worker && wxt build",
        "build:firefox": "pnpm build:worker && wxt build -b firefox",
        "zip": "wxt zip",
        "zip:firefox": "wxt zip -b firefox",
        "compile": "vue-tsc --noEmit",
        "postinstall": "wxt prepare",
        "build-lib": "wasm-pack build lib/imagehash --target web",
        "build:worker": "tsc workers/encode-worker.ts --ignoreConfig --outDir public --target es2022 --lib es2022,dom --module esnext --moduleResolution bundler --skipLibCheck && wxt prepare",
        "sign": "tsx utils/signExtension.ts",
        "test": "pnpm test:unit && pnpm test:e2e",
        "test:unit": "vitest run",
        "test:e2e": "playwright test",
        "lint": "biome check .",
        "typecheck": "pnpm build:worker && vue-tsc --noEmit",
        "test:e2e:firefox": "VITE_E2E_GALLERY_ORIGIN=127.0.0.1:18474 pnpm --dir ../booru-lightbox-extension build:firefox && pnpm build:firefox && E2E_PORT=18474 playwright test --config playwright.firefox.config.ts"
    },
    "dependencies": {
        "@mdi/js": "^7.4.47",
        "@tanstack/vue-query": "^5.104.5",
        "@vueuse/core": "^15.0.0",
        "file64": "^1.0.6",
        "idb": "^8.0.4",
        "imagehash-rs": "link:lib/imagehash/pkg",
        "ky": "^2.2.0",
        "mdi-vue": "^3.0.13",
        "tailwindcss": "^4.3.3",
        "uuidv7": "^1.2.1",
        "vue": "^3.5.44"
    },
    "devDependencies": {
        "@biomejs/biome": "^2.6.2",
        "@playwright/test": "^1.64.1",
        "@tailwindcss/vite": "^4.3.3",
        "@types/firefox-webext-browser": "^143.0.1",
        "@types/shelljs": "^0.10.0",
        "@vitejs/plugin-vue": "^6.0.10",
        "@vue/test-utils": "^2.5.1",
        "@wxt-dev/auto-icons": "^1.1.2",
        "@wxt-dev/module-vue": "^1.0.3",
        "clipanion": "4.0.0-rc.4",
        "cross-var": "^1.1.0",
        "dotenv": "^18.0.8",
        "fake-indexeddb": "^6.2.6",
        "jsdom": "^30.1.3",
        "jwt-simple": "^0.5.6",
        "sass-embedded": "^1.106.1",
        "shelljs": "^0.10.0",
        "typescript": "npm:typescript-native-bridge@6.0.3-bridge.19.tsgo.7.0.2",
        "vite": "^8.3.5",
        "vitest": "^5.0.5",
        "vue-tsc": "^3.3.13",
        "wasm-pack": "^0.15.0",
        "web-ext": "^10.8.0",
        "wxt": "^0.21.4",
        "yocto-spinner": "^1.2.2"
    }
}
